<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.cpnvisualsystem.mapper.CarriageInfoMapper">

    <resultMap id="BaseResultMap" type="org.cpnvisualsystem.entity.CarriageInfo">
        <id column="id" property="id" />
        <result column="cluster_id" property="clusterId" />
        <result column="train_id" property="trainId" />
        <result column="carriage_code" property="carriageCode" />
        <result column="type" property="type" />
        <result column="position" property="position" />
        <result column="device_count" property="deviceCount" />
        <result column="status" property="status" />
    </resultMap>

    <!-- 用于映射车厢视图及其搭载的设备列表 -->
    <resultMap id="CarriageViewResultMap" type="org.cpnvisualsystem.entity.vo.CarriageViewVO">
        <result column="car_no" property="carNo"/>
        <result column="device_count" property="deviceCount"/>
        <collection property="deviceName" ofType="java.lang.String">
            <result column="device_name"/>
        </collection>
    </resultMap>

    <sql id="Base_Column_List">
        id, cluster_id, train_id, carriage_code, type, position, device_count, status
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM carriage_info
        WHERE id = #{id}
    </select>

    <select id="selectCarriagesByTrainId" resultType="org.cpnvisualsystem.entity.CarriageInfo">
        SELECT * FROM carriage_info WHERE train_id = #{trainId}
    </select>

    <!-- 已有的：根据车厢ID获取车厢视图 (加上 COLLATE 解决字符集冲突) -->
    <select id="selectCarriageViewByCarriageId" resultMap="CarriageViewResultMap">
        SELECT
            c.id as car_no,
            (SELECT COUNT(*) FROM compute_power_tag WHERE carriage = CAST(c.id AS CHAR)) as device_count,
            t.cp_model as device_name
        FROM carriage_info c
                 LEFT JOIN compute_power_tag t
                           ON CAST(c.id AS CHAR) COLLATE utf8mb4_unicode_ci = t.carriage COLLATE utf8mb4_unicode_ci
        WHERE c.id = #{carriageId}
    </select>

    <select id="countCarriagesByTrainId" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM carriage_info
        WHERE train_id = #{trainId}
    </select>

    <!-- 新增的：根据列车ID获取该列车下所有车厢的视图数据 (加上 COLLATE 解决字符集冲突) -->
    <select id="selectCarriageViewByTrainId" resultMap="CarriageViewResultMap">
        SELECT
            c.id as car_no,
            (SELECT COUNT(*) FROM compute_power_tag WHERE carriage = CAST(c.id AS CHAR)) as device_count,
            t.cp_model as device_name
        FROM carriage_info c
                 LEFT JOIN compute_power_tag t
                           ON CAST(c.id AS CHAR) COLLATE utf8mb4_unicode_ci = t.carriage COLLATE utf8mb4_unicode_ci
        WHERE c.train_id = #{trainId}
    </select>
</mapper>